---
import Base from "../layouts/Base.astro";
import ListaDeArtigos from "../components/ListaDeArtigos.astro";
import Perfil from "../textos/perfil.md";
import { site, author } from "../config";
import { getArtigos } from "../lib/artigos";
import { grafo, pessoa, siteWeb } from "../lib/jsonld";

const artigos = await getArtigos();
---

<Base
  title={site.name}
  description={site.description}
  ogType="profile"
  jsonLd={grafo(
    siteWeb(),
    {
      "@type": "ProfilePage",
      "@id": `${site.url}/#perfil`,
      url: `${site.url}/`,
      name: `${author.name} – ${author.jobTitle}`,
      inLanguage: site.lang,
      mainEntity: { "@id": author.id },
    },
    pessoa(),
  )}
>
  <h1 class="visualmente-oculto">{site.name}</h1>
  <div class="perfil"><Perfil /></div>

  <h2 class="visualmente-oculto">Artigos</h2>
  <ListaDeArtigos artigos={artigos} />
</Base>
