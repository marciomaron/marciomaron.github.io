---
import { site } from "../config";

interface Props {
  trail?: { label: string; href?: string }[];
}
const { trail = [] } = Astro.props;
const currentPath = Astro.url.pathname;
---

<nav class="breadcrumbs" aria-label="Navegação">
  <a class="home-link" href="/" aria-current={currentPath === "/" ? "page" : undefined}>{site.name}</a>
  <details class="site-menu">
    <summary aria-label="Abrir menu" title="Menu">
      <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m4 6 4 4 4-4"></path></svg>
    </summary>
    <div class="menu-panel">
      <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>Início</a>
      {
        site.nav.map(({ label, href }) => (
          <a href={href} aria-current={currentPath === href ? "page" : undefined}>
            {label}
          </a>
        ))
      }
      <a href="/rss.xml">RSS</a>
    </div>
  </details>
  {
    trail.map((item, i) => (
      <>
        <span class="separator" aria-hidden="true">/</span>
        {item.href && i < trail.length - 1 ? (
          <a class="crumb" href={item.href}>
            {item.label}
          </a>
        ) : (
          <span class="crumb crumb-current" aria-current="page" title={item.label}>
            {item.label}
          </span>
        )}
      </>
    ))
  }
</nav>

<script>
  document.querySelectorAll<HTMLDetailsElement>(".site-menu").forEach((menu) => {
    const summary = menu.querySelector("summary")!;
    document.addEventListener("pointerdown", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        menu.open = false;
        summary.focus();
        event.preventDefault();
      }
      if (event.key === "Tab")
        requestAnimationFrame(() => {
          if (!menu.contains(document.activeElement)) menu.open = false;
        });
    });
  });
</script>
