---
import { site, author } from "../config";
import Breadcrumb from "../components/Breadcrumb.astro";
import "../styles/global.css";

interface Props {
  /** Título da página. Na página inicial, use o nome do site. */
  title: string;
  description: string;
  /** Trilha de navegação após "Principal". */
  trail?: { label: string; href?: string }[];
  /** Caminho da imagem de compartilhamento (padrão: /og/padrao.png). */
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  jsonLd?: object;
  article?: { published: string; modified: string; tags: string[] };
  noindex?: boolean;
}
const {
  title,
  description,
  trail = [],
  ogImage = "/og/padrao.png",
  ogType = "website",
  jsonLd,
  article,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title === site.name ? `${site.name} – ${site.tagline}` : `${title} – ${site.name}`;
const ogImageUrl = new URL(ogImage, site.url).href;
const gaId = import.meta.env.PROD ? site.googleAnalyticsId : "";
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.dataset.js = "";
      try {
        var t = localStorage.getItem("esquema-de-cores");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={author.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} – RSS`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    {
      article && (
        <>
          <meta property="article:published_time" content={`${article.published}T00:00:00-03:00`} />
          <meta property="article:modified_time" content={`${article.modified}T00:00:00-03:00`} />
          <meta property="article:author" content={author.url} />
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag("js", new Date());
            gtag("config", gaId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <div class="shell">
      <header class="site-header">
        <Breadcrumb trail={trail} />
        <button type="button" class="theme-toggle" aria-label="Alternar modo claro e escuro">
          <svg class="icon-sun" aria-hidden="true" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="2.2"></circle><path d="M8 1.6v1.6M8 12.8v1.6M1.6 8h1.6M12.8 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M12.6 3.4l-1.1 1.1M4.5 11.5l-1.1 1.1"></path></svg>
          <svg class="icon-moon" aria-hidden="true" viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.2 2.2a4.8 4.8 0 1 0 4.6 6.4 3.8 3.8 0 1 1-4.6-6.4z"></path></svg>
        </button>
      </header>
      <main id="conteudo"><slot /></main>
      <footer class="site-footer">
        <p>
          <a href="/">{author.name}</a> · {author.jobTitle} · {author.city}
        </p>
        <p>
          <a href={author.whatsapp}>WhatsApp</a> · <a href={`mailto:${author.email}`}>E-mail</a> ·
          <a href={author.linkedin} rel="me">LinkedIn</a> · <a href="/contato/">Contato</a> · <a href="/rss.xml">RSS</a>
        </p>
      </footer>
    </div>
    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const current = () =>
        root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      toggle?.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("esquema-de-cores", next);
        } catch {}
      });
    </script>
  </body>
</html>
